# Public origin and support
SITE_URL=http://localhost:5173
SUPPORT_EMAIL=support@modelcarcenter.com

# Founder-only ChatGPT-authenticated admin allowlist
ADMIN_EMAILS=founder@example.com
# Local development only. Ignored when NODE_ENV=production.
ADMIN_DEV_BYPASS=false

# Stripe marketplace and Connect
STRIPE_SECRET_KEY=sk_test_replace_me
# Platform-account webhook signing secret for /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Connected-account webhook signing secret for /api/stripe/webhook-connect.
# This must be different from STRIPE_WEBHOOK_SECRET.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_replace_me_connect
STRIPE_API_VERSION=2026-02-25.clover
COLLECTOR_MARKETPLACE_FEE_BPS=850
PROFESSIONAL_MARKETPLACE_FEE_BPS=700
FOUNDING_SELLER_MARKETPLACE_FEE_BPS=500
FOUNDING_SELLER_PROMOTION_MONTHS=6
CHECKOUT_EXPIRATION_MINUTES=30
SHIPPING_COUNTRIES=US
STRIPE_AUTOMATIC_TAX=false
STRIPE_SHIPPING_TAX_CODE=txcd_92010001
STRIPE_TAX_BEHAVIOR=exclusive

# Shippo fulfillment. Keep the token server-side; use shippo_test_... locally.
SHIPPO_API_KEY=shippo_test_replace_me
SHIPPO_API_VERSION=2018-02-08
# Random secret included in the Shippo webhook URL; do not reuse the API token.
SHIPPO_WEBHOOK_SECRET=replace_with_a_long_random_webhook_secret
SHIPPO_INSURANCE_THRESHOLD_CENTS=25000
SHIPPO_SIGNATURE_THRESHOLD_CENTS=75000
SHIPPO_QUOTE_EXPIRATION_MINUTES=20
SHIPPO_MAX_LABEL_COST_CENTS=10000

# Transactional email
RESEND_API_KEY=re_replace_me
EMAIL_FROM=Model Car Center <support@modelcarcenter.com>

# Public collector authentication (generate at least 32 random bytes)
BETTER_AUTH_SECRET=replace_with_a_long_random_secret_at_least_32_characters
